# ---------------------------------------------------------------------------
# DataSphere — environment configuration
# Copy to .env and adjust. Never commit .env.
#
# The values below are the LOCAL DEVELOPMENT defaults and are safe to share:
# they only ever reach a throwaway container on your own machine.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API ---------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
# These four are consumed by the postgres container itself.
POSTGRES_DB=datasphere
POSTGRES_USER=datasphere
POSTGRES_PASSWORD=datasphere_dev_pw
POSTGRES_PORT=5432

# The API, migrations and scripts use DATABASE_URL.
# Host is `localhost` when running on the host machine, `postgres` inside compose.
DATABASE_URL=postgres://datasphere:datasphere_dev_pw@localhost:5432/datasphere

# Connection pool sizing for the API process.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Query engine guardrails -------------------------------------------------
# Hard ceiling on rows returned by any compiled query, regardless of user LIMIT.
QUERY_MAX_ROWS=10000
# Postgres statement_timeout applied to every analytical query, in milliseconds.
QUERY_TIMEOUT_MS=15000

# --- Cache -------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=ds:q

# --- Seeding -----------------------------------------------------------------
# Number of rows to generate in fact_orders. 2,000,000 is the documented target.
# Lower it (e.g. 100000) for a fast local smoke test.
SEED_FACT_ROWS=2000000
SEED_CUSTOMERS=50000
SEED_PRODUCTS=5000
SEED_STORES=200
SEED_DATE_START=2021-01-01
SEED_DATE_END=2025-12-31
# Rows per COPY batch during bulk load.
SEED_BATCH_SIZE=50000
# Deterministic PRNG seed so every run produces byte-identical data.
SEED_RANDOM_SEED=20240617

# --- Web ---------------------------------------------------------------------
WEB_PORT=5173
# Baked into the frontend bundle at build time. Empty string = same-origin
# (which is what the nginx container does, proxying /api to the api service).
VITE_API_BASE_URL=http://localhost:4000
