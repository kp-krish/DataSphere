{
  "name": "@datasphere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataSphere REST API - catalog introspection, query execution, dashboards",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=../../.env scripts/migrate.ts down"
  },
  "dependencies": {
    "@datasphere/core": "*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.21.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
