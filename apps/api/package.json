{
  "name": "@datasphere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataSphere REST API - catalog introspection, query execution, dashboards",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=../../.env scripts/migrate.ts down"
  },
  "dependencies": {
    "@datasphere/core": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
