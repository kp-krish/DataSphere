{
  "name": "datasphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataSphere — a cloud data visualization platform with a dynamic SQL query engine",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build -w @datasphere/core && npm run build -w @datasphere/api && npm run build -w @datasphere/web",
    "dev": "npm run dev -w @datasphere/api & npm run dev -w @datasphere/web",
    "dev:api": "npm run dev -w @datasphere/api",
    "dev:web": "npm run dev -w @datasphere/web",
    "migrate": "npm run migrate -w @datasphere/api",
    "migrate:down": "npm run migrate:down -w @datasphere/api",
    "seed": "npm run seed -w @datasphere/scripts",
    "benchmark": "npm run benchmark -w @datasphere/scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dump:catalog": "npm run dump:catalog -w @datasphere/scripts",
    "seed:dashboards": "npm run seed:dashboards -w @datasphere/scripts",
    "screenshot": "npm run screenshot -w @datasphere/scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
